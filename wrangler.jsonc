{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yishuai-wang",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{"binding": "BLOG_DB", "database_name": "yishuai-blog", "database_id": "local-blog", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "BLOG_MEDIA", "bucket_name": "yishuai-blog-media"}],
  "env": {
    "production": {
      "name": "yishuai-wang",
      "account_id": "65f490f1b9a522222b59036b2c359ef9",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{"pattern": "yishuai.wang", "custom_domain": true}],
      "vars": {
        "NUXT_PUBLIC_SITE_URL": "https://yishuai.wang",
        "NUXT_PUBLIC_INDEXABLE": "true",
        "NUXT_OWNER_GITHUB_ID": "25154825"
      },
      "d1_databases": [{"binding": "BLOG_DB", "database_name": "yishuai-blog", "database_id": "8e364dc6-531d-4901-bd0e-48214ae4ea6c", "migrations_dir": "migrations"}],
      "r2_buckets": [{"binding": "BLOG_MEDIA", "bucket_name": "yishuai-blog-media"}],
      "observability": {"enabled": true}
    }
  }
}
