    "@quirekit/incremark": "0.0.1-alpha.1",
    "@quirekit/inkwash": "0.0.1-alpha.1",
    "@quirekit/md-editor": "0.0.1-alpha.1",
    "@quirekit/msfe-core": "0.0.1-alpha.1",
    "@quirekit/msfe-starter-kit": "0.0.1-alpha.1",
    "@quirekit/msfe-vue": "0.0.1-alpha.1",
    "@quirekit/ui": "0.0.1-alpha.1",
    "@quirekit/unocss-preset": "0.0.1-alpha.1",
    "h3": "1.15.11",
    "markdown-it": "14.1.0",
