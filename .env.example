NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3288
NUXT_PUBLIC_INDEXABLE=false
# Set your own immutable numeric GitHub user ID to enable author permissions.
NUXT_OWNER_GITHUB_ID=
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=
# Independent 32-byte hex key for encrypting the DeepSeek Key entered in Manage.
NUXT_AI_SETTINGS_SECRET=
# Use an IndieAuth-compatible token introspection endpoint when configuring Micropub.
NUXT_INDIEAUTH_TOKEN_ENDPOINT=
NUXT_INDIEAUTH_AUTHORIZATION_ENDPOINT=
NUXT_INDIEAUTH_INTROSPECTION_ENDPOINT=
NUXT_INDIEAUTH_INTROSPECTION_AUTHORIZATION=
