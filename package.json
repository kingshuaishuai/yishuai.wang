{
  "name": "yishuai-wang",
  "version": "0.1.0",
  "description": "Personal website and blog built with Nuxt and QuireKit, with online writing, Micropub, RSS and Markdown endpoints.",
  "license": "MIT",
  "author": "Yishuai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingshuaishuai/yishuai.wang.git"
  },
  "homepage": "https://github.com/kingshuaishuai/yishuai.wang#readme",
  "bugs": {
    "url": "https://github.com/kingshuaishuai/yishuai.wang/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3288",
    "build": "nuxt build",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "verify:http": "tsx scripts/verify-http.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "preview": "tsx scripts/preview.ts",
    "db:migrate": "wrangler d1 migrations apply BLOG_DB --local",
    "db:seed": "tsx scripts/seed.ts",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@ark-ui/vue": "5.39.1",
    "@lezer/highlight": "1.2.5",
